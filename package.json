{
  "name": "@tamng0905/builder-essential-skills",
  "version": "0.1.0",
  "description": "Builder's Essential Skills — reusable workflows for Claude Code and Codex",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js && npm --prefix apps/radar test",
    "radar:agent": "node bin/radar-agent.js",
    "radar:build": "npm --prefix apps/radar run build",
    "radar:dev": "npm --prefix apps/radar run dev",
    "radar:harness": "node bin/radar-harness.js",
    "radar:lint": "npm --prefix apps/radar run lint",
    "radar:start": "npm --prefix apps/radar run start",
    "radar:typecheck": "npm --prefix apps/radar run typecheck"
  },
  "bin": {
    "builder-essential-skills": "bin/builder-essential-skills.js",
    "radar-agent": "bin/radar-agent.js",
    "radar-harness": "bin/radar-harness.js"
  },
  "files": [
    "bin",
    "harness",
    "packages/radar-contract",
    "skills",
    "assets",
    ".claude/agents",
    "install.ps1",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
