{
  "schemaVersion": 1,
  "campaignId": "topic-example-bounded-loop",
  "runId": "run-2026-08-02-topic-example",
  "subject": {
    "kind": "topic",
    "id": "topic-example"
  },
  "title": "Bounded generic experiment campaign",
  "question": "Which controlled candidate change improves the fixed evaluation outcome?",
  "hypothesis": "A bounded change to the candidate parameters can improve the primary score without failing the validity check.",
  "seedInputDir": "seeds/generic-campaign",
  "mutablePaths": ["candidate.json"],
  "image": "science",
  "command": ["python", "evaluate.py"],
  "network": "none",
  "environment": {
    "EXPERIMENT_SEED": "1729"
  },
  "resources": {
    "cpus": 1,
    "memoryMb": 1024,
    "timeoutSeconds": 120
  },
  "expectedArtifacts": [
    {
      "path": "evaluation.json",
      "required": true,
      "mimeType": "application/json",
      "description": "Field-neutral metrics and validity checks for this iteration."
    }
  ],
  "evaluation": {
    "artifactPath": "evaluation.json",
    "primaryMetric": {
      "name": "primary_score",
      "direction": "maximize",
      "minDelta": 0.001
    },
    "requiredChecks": ["finite result", "within declared bounds"]
  },
  "limits": {
    "maxIterations": 1000
  }
}
